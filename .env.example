# Template. Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; this file is committed.
#
# Only secrets live here. Non-secret config (DB host/user/password, model name)
# has sensible defaults in application.properties and docker-compose.yml, so it
# works out of the box both locally and in Docker.

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_your_own_secret
JWT_EXPIRATION=86400000

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_key
