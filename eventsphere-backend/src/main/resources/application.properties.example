spring.datasource.url=jdbc:postgresql://localhost:5432/eventsphere
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
jwt.secret=replace_with_your_own_secret_key
jwt.expiration=86400000

spring.ai.openai.api-key=your_gemini_api_key_here
spring.ai.openai.base-url=https://generativelanguage.googleapis.com/v1beta/openai
spring.ai.openai.chat.options.model=gemini-flash-latest